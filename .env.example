# backend/.env: the settings the application needs BEFORE it can open its database, and nothing else.
# `npm start` creates this file for you if it is missing (and adds SECRET_KEY). Everything you used to
# type here (the logins, "engine on", "real money", the Quotex address) is now typed on the dashboard's
# Settings page and kept, encrypted where it is secret, in the database. `.env` is git-ignored.

# --- Server ---
# Keep 127.0.0.1: the API can place trades, and the login is sent over plain http.
HOST=127.0.0.1
PORT=8000
# Only set to true if you understand that anyone who can reach the port can trade on your account.
ALLOW_PUBLIC_BIND=false

# --- App ---
# (The Docker image sets CONTAINER=true and HOST=0.0.0.0 itself; see docs/DOCKER.md. Do not set
# them by hand: CONTAINER lets the application listen on all addresses, which is only safe when
# Docker publishes the port to 127.0.0.1.)
# CONTAINER=false
ENVIRONMENT=development      # development | production
DATA_DIR=data                # the database, logs and (command-line) sessions; git-ignored
CORS_ORIGIN=http://127.0.0.1:5173
# The built dashboard that the backend serves (`npm run build`). Relative to backend/.
# FRONTEND_DIR=../frontend/dist

# --- Logs ---
# Besides the console, logs go to DATA_DIR/logs/engine.log as JSON lines, rotated so they never
# fill the disk. Passwords and the Telegram hash are masked in them.
LOG_TO_FILE=true
LOG_MAX_MB=10                # size of one log file before it is rotated
LOG_BACKUPS=5                # how many rotated files are kept

# --- The key to the stored logins ---
# Encrypts what you store on the dashboard. You do not write it: `npm start` (or `npm run key:create`)
# adds a line `SECRET_KEY=...` here if there is none. KEEP A COPY of this file somewhere safe: without
# the key the stored logins cannot be read again. Never share it, and never keep it next to a backup
# of the database. (A key in the environment variable SECRET_KEY works too, for a server.)
# SECRET_KEY=

# --- Starting values for settings that live on the dashboard ---
# The Settings page wins over these. They are only used until you save the setting there.
# LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
# QUOTEX_HOST=quotex.com     # the broker's domain; it changes now and then
# QUOTEX_TIME_MODE=TIME      # TIME = next clock-aligned expiry, TIMER = a countdown

# --- Old logins (optional; still honoured until you move them) ---
# Logins written here keep working, but a login stored on the dashboard wins over them. Move them
# with `npm run env:import` (or the button on the Settings page), then delete these lines: they sit
# here in plain text. (The engine's on/off switch and the real-money permission are no longer read
# from this file: ENGINE_ENABLED and QUOTEX_ALLOW_REAL are gone, on purpose.)
# QUOTEX_EMAIL=you@example.com
# QUOTEX_PASSWORD=your-password
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# TELEGRAM_PHONE=+254712345678
# The next two are filled in by the application from the logins you make on the dashboard. Leave them
# alone; each is a login, as secret as a password.
# QUOTEX_SESSION=
# TELEGRAM_SESSION=

# --- API limits ---
# Commands (anything that changes something) are rate limited: a burst, then this many per second.
# API_COMMAND_BURST=40
# API_COMMAND_RATE_PER_S=10
# WebSocket: messages queued per dashboard before it is sent a fresh snapshot instead, and the
# seconds of quiet before a heartbeat.
# WS_CLIENT_QUEUE=1000
# WS_HEARTBEAT_S=15
