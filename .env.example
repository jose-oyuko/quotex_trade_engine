# Copy to `.env` (same folder as the backend is started from: backend/.env) and edit.
# `.env` is git-ignored. Never commit real values.

# --- Server ---
# Keep 127.0.0.1: the API can place trades, and the login is sent over plain http.
HOST=127.0.0.1
PORT=8000
# Only set to true if you understand that anyone who can reach the port can trade on your account.
ALLOW_PUBLIC_BIND=false

# --- App ---
ENVIRONMENT=development      # development | production
# LOG_LEVEL, QUOTEX_HOST and QUOTEX_TIME_MODE can be changed on the dashboard's Settings page, which
# wins over what is written here. The lines below are only the starting values.
# LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
DATA_DIR=data                # sqlite file, sessions, logs (git-ignored)
CORS_ORIGIN=http://127.0.0.1:5173
# The built dashboard that the backend serves (`npm run build`). Relative to backend/.
# FRONTEND_DIR=../frontend/dist

# --- Logs (Phase 9) ---
# Besides the console, logs go to DATA_DIR/logs/engine.log as JSON lines, rotated so they never
# fill the disk. Passwords and the Telegram hash are masked in them.
LOG_TO_FILE=true
LOG_MAX_MB=10                # size of one log file before it is rotated
LOG_BACKUPS=5                # how many rotated files are kept

# --- Stored logins (Phase 11) ---
# The key that encrypts the logins you store in the dashboard. You do not write it: `npm start` (or
# `npm run key:create`) adds a line `SECRET_KEY=...` here if there is none. KEEP A COPY of this file
# somewhere safe: without the key the stored logins cannot be read again. Never share it, and never
# keep it next to a backup of the database.
# SECRET_KEY=

# --- Quotex (Phase 2) ---
# Put these in backend/.env. They are secrets: never commit them, never paste them anywhere.
# QUOTEX_EMAIL=you@example.com
# QUOTEX_PASSWORD=your-password
# The broker's domain. It changes now and then (qxbroker.com stopped working; quotex.com works).
# See the README for what to do when it changes.
# QUOTEX_HOST=quotex.com
# Starting value only: the dashboard's Settings page decides (with your password) and remembers it.
# Real-money trading stays impossible until it is allowed there and the account is switched explicitly.
# QUOTEX_ALLOW_REAL=false
# TIME = expire at the next clock-aligned expiry (library default), TIMER = countdown of N seconds.
# QUOTEX_TIME_MODE=TIME

# --- Telegram (Phase 3) ---
# Create the id and hash at https://my.telegram.org -> "API development tools". They identify your
# app to Telegram and are secrets: never commit them. The login code and any two-step password are
# typed into `npm run telegram:login` and are never stored here.
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Optional (the login script asks if it is missing): international format, no leading 0.
# TELEGRAM_PHONE=+254712345678
# TELEGRAM_SESSION= is filled in by the application from the login you make on the dashboard (Settings >
# Telegram). Leave it alone; it is a login, as secret as a password.

# --- Trading engine (Phase 4) ---
# Start and stop the engine on the dashboard's Settings page: it remembers what you left running.
# This line is only the starting value for an installation where that was never decided
# (false: the application starts without touching Quotex or Telegram).
# ENGINE_ENABLED=false

# --- API limits (Phase 6) ---
# Commands (anything that changes something) are rate limited: a burst, then this many per second.
# API_COMMAND_BURST=40
# API_COMMAND_RATE_PER_S=10
# WebSocket: messages queued per dashboard before it is sent a fresh snapshot instead, and the
# seconds of quiet before a heartbeat.
# WS_CLIENT_QUEUE=1000
# WS_HEARTBEAT_S=15
